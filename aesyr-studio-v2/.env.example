# Server-side only. Copy to .env.local (git-ignored) and fill in.
# Without OPENAI_API_KEY, story generation returns an offline draft built from the template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 2D casting images (Google Gemini image model). Without it the 2D button explains what to set.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3-pro-image
