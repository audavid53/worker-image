# Server-side only. Copy to .env.local (git-ignored) and fill in.
# Without OPENAI_API_KEY, story generation returns an offline draft built from the template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# 2D casting images (Google Gemini image model). Without it the 2D button explains what to set.
GOOGLE_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3-pro-image
# Motion jobs (shared/motion.ts, server/jobs.ts)
# Tripo: models, rigs and preset clips. The API account needs Tripo credit of its own.
TRIPO_API_KEY=
# RunPod Serverless workers (workers/blender = CPU, workers/unimate = GPU); see workers/README.md.
RUNPOD_API_KEY=
RUNPOD_BLENDER_ENDPOINT_ID=
RUNPOD_UNIMATE_ENDPOINT_ID=
# Without RUNPOD_BLENDER_ENDPOINT_ID, object motion runs on this machine's Blender (auto-detected).
BLENDER_PATH=
# Credits the local dev user starts with (no Supabase locally yet).
DEV_CREDITS=1000
